configfile: "config/config.yaml"

OBJECTS = ['cells', 'triggercells', 'modules', 'cells_by_module']
LAYERS_CEE = range(1,27)
LAYERS_CEH = range(1,22)
SUBDETS = ['cee']

rule all:
  input:
    f"results/{config['geometry']}/plot_errors.html"

rule extract_geometry_cee:
  input:
    f"resources/{config['geometry']}.root"
  output:
    expand(f"resources/{config['geometry']}/cee_layer{{layer}}/{{object}}.parquet", layer=LAYERS_CEE, object=OBJECTS)
  shell:
    f"extract-geometry --geometry {config['geometry']} --subdet cee"

rule extract_geometry_ceh:
  input:
    f"resources/{config['geometry']}.root"
  output:
    expand(f"resources/{config['geometry']}/ceh_layer{{layer}}/{{object}}.parquet", layer=LAYERS_CEH, object=OBJECTS)
  shell:
    f"extract-geometry --geometry {config['geometry']} --subdet ceh"

rule create_module_geojson:
  input:
    expand(f"resources/{config['geometry']}/cee_layer{{layer}}/{{object}}.parquet", layer=LAYERS_CEE, object=OBJECTS),
    expand(f"resources/{config['geometry']}/ceh_layer{{layer}}/{{object}}.parquet", layer=LAYERS_CEH, object=OBJECTS)
  output:
    expand(f"resources/{config['geometry']}/geojson/module/cee_layer{{layer}}.json", layer=LAYERS_CEE),
    expand(f"resources/{config['geometry']}/geojson/module/ceh_layer{{layer}}.json", layer=LAYERS_CEH)
  shell:
    f"create-geojson --geometry {config['geometry']} --object module"

rule create_stc_geojson:
  input:
    expand(f"resources/{config['geometry']}/ceh_layer{{layer}}/{{object}}.parquet", layer=LAYERS_CEH, object=OBJECTS)
  output:
    expand(f"resources/{config['geometry']}/geojson/stc/ceh_layer{{layer}}.json", layer=LAYERS_CEH)
  shell:
    f"create-geojson --geometry {config['geometry']} --object stc"

rule plot:
  input:
    expand(f"resources/{config['geometry']}/geojson/module/cee_layer{{layer}}.json", layer=LAYERS_CEE),
    expand(f"resources/{config['geometry']}/geojson/module/ceh_layer{{layer}}.json", layer=LAYERS_CEH),
    expand(f"resources/{config['geometry']}/cee_layer{{layer}}/{{object}}.parquet", layer=LAYERS_CEE, object=OBJECTS),
    expand(f"resources/{config['geometry']}/ceh_layer{{layer}}/{{object}}.parquet", layer=LAYERS_CEH, object=OBJECTS),

  output:
    f"results/{config['geometry']}/plot_errors.html"
  shell:
    f"quarto render notebooks/plot_errors.ipynb --execute  --output-dir ../results/{config['geometry']} -P geometry_name:{config['geometry']}"
